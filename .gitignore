# --- Secrets (NEVER commit) ---------------------------------------------
# WHY: .env holds AZURE_OPENAI_API_KEY. It is listed first on purpose so the
# rule exists before the file is ever created.
.env
*.key

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- Large / regenerable artifacts --------------------------------------
# WHY: the raw BEIR download (~100 MB) and the embedding/index caches
# (~90 MB per model) are reproducible from scripts, so they stay out of git.
data/raw/
artifacts/
dist/
.cache/
# LLM response cache (may contain model outputs; regenerable)
.llm_cache/

# --- OS / editor --------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# toy runs of the eval/bench pipeline on the tiny dataset (docs/from_zero/06)
toy_runs/

# personal practice files (not part of the repo)
exercises/

# simple scenario runs: console.txt, events.jsonl, replay.html and SUMMARY.md are checked in;
# the cluster logs (local paths) and run.json (wall time for SUMMARY.md) are not
scenarios/SimpleScenarios/results/**/cluster_logs/
scenarios/SimpleScenarios/results/**/run.json
# agent memory of the A2A server (personal data: never commit)
*.sqlite
# Office lock files (Word / PowerPoint create them while a file is open)
~$*
