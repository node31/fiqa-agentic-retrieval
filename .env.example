# Copy to .env and fill in. .env is gitignored.
# Azure AI Foundry project endpoint (OpenAI v1 surface). Must end with /openai/v1/
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-6-sol
AZURE_OPENAI_API_KEY=<your-key>

# Which LLM backend agents use: fake | copilot | azure
#   fake    - scripted, free, deterministic (tests, toys)
#   copilot - GitHub Copilot CLI (`copilot -p`), free dev loop
#   azure   - real Foundry deployment; also needs --confirm-spend on the CLI
LLM_BACKEND=fake
COPILOT_MODEL=claude-haiku-4.5

# Cost placeholders (USD per 1M tokens). Unknown for gpt-6-sol: fill in from your price sheet.
PRICE_PER_1M_INPUT=1.00
PRICE_PER_1M_OUTPUT=4.00
